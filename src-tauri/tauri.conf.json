{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synonik",
  "version": "0.3.1",
  "identifier": "com.synonik.app",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synonik",
        "visible": false,
        "width": 800,
        "height": 600,
        "minWidth": 360,
        "minHeight": 300,
        "decorations": false,
        "transparent": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "img-src": [
          "'self'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "script-src": [
          "'self'"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "msi", "app", "dmg"],
    "resources": {
      "../database.sqlite": "database.sqlite"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Polish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "pl-PL"
      }
    }
  }
}
